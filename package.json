{
  "name": "shop-base-ai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "pnpm --filter @shop/web dev",
    "build": "pnpm --filter @shop/web build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "check": "pnpm typecheck && pnpm test && pnpm test:integration && pnpm build"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
