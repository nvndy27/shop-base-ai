# Copy to apps/web/.env.local for Next.js development. Never commit credentials.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://localhost:3000
# M1 uses only user-scoped JWTs; no service-role/secret key is needed.
# Google OAuth and phone OTP require provider configuration in Supabase.
# Server-only Elasticsearch configuration. API key has read access to the catalog index only.
ELASTIC_URL=https://localhost:9200
ELASTIC_SEARCH_KEY_FILE=
ELASTIC_CA_FILE=
ELASTIC_MARKETPLACE_SEARCH_KEY_FILE=
# Trusted worker/server only. Store secrets in private files, never VITE_*.
ELASTIC_MARKETPLACE_WORKER_KEY_FILE=
MARKETPLACE_SERVICE_KEY_FILE=
# scripts/configure-elasticsearch-search.py configures local absolute paths, not browser secrets.

# Server-only local translations. Rows: {id, original, vi}. No browser credentials.
CATALOG_TRANSLATIONS_FILE=
